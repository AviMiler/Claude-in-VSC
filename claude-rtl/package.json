{
  "name": "claude-rtl",
  "displayName": "Claude Code RTL",
  "description": "מוסיף תמיכה בכיוון ימין-לשמאל לתוסף הרשמי של Claude Code",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.91.0" },
  "extensionKind": ["workspace"],
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "claudeRtl.enable", "title": "הפעלת RTL", "category": "Claude RTL" },
      { "command": "claudeRtl.disable", "title": "ביטול RTL (שחזור)", "category": "Claude RTL" }
    ],
    "configuration": {
      "title": "Claude RTL",
      "properties": {
        "claudeRtl.autoApply": {
          "type": "boolean",
          "default": true,
          "description": "מחיל מחדש את ה-RTL אוטומטית אחרי עדכון של התוסף הרשמי"
        },
        "claudeRtl.extensionId": {
          "type": "string",
          "default": "anthropic.claude-code",
          "description": "מזהה התוסף הרשמי"
        }
      }
    }
  }
}
